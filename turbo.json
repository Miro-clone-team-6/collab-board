{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "12",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["PORT", "DATABASE_URL", "ALLOWED_ORIGINS", "NODE_ENV"]
    },
    "//#lint:biome": {},
    "lint:fsd": {
      "inputs": ["src/**", "steiger.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "generate": {
      "cache": false
    }
  }
}
