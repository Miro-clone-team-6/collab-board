{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "12",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "API_INTERNAL_URL",
        "PORT",
        "DATABASE_URL",
        "ALLOWED_ORIGINS",
        "NODE_ENV",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_DB",
        "POSTGRES_HOST",
        "POSTGRES_PORT"
      ]
    },
    "//#lint:biome": {},
    "//#lint:docs": {
      "cache": false
    },
    "lint:fsd": {
      "inputs": ["src/**", "steiger.config.ts", "tsconfig.json"],
      "outputs": []
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "generate": {
      "cache": false
    }
  }
}
