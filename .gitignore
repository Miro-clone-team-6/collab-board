# Dependencies and package-manager cache
**/node_modules/
**/.pnpm-store/

# Build outputs and cache
**/.next/
**/next-env.d.ts
**/dist/
/apps/api/src/generated/
**/build/
**/.turbo/
**/*.tsbuildinfo

# Local environment files (keep templates)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
/docker-compose.override.yml

# Local tool settings and credentials
**/.agents/
**/.codex/
**/.aws/
**/.specify/
**/.cursor/
**/.vscode/*
# Общие настройки редактора для проекта: язык Tailwind для CSS и рекомендуемые расширения.
!/.vscode/settings.json
!/.vscode/extensions.json
**/.idea/

# OS files
**/.DS_Store

# Logs and test coverage
**/npm-debug.log*
**/pnpm-debug.log*
**/coverage/
**/*.lcov
**/coverage.out
