datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  note      String?
  checkedAt DateTime @default(now())

  @@map("health_checks")
}
