{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Сервис доступен и функционирует штатно\n\nСервис доступен и функционирует штатно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Проверка работоспособности сервиса",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "CollabBoard API",
    "description": "Спецификация API интерактивной доски",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-11-10T10:00:00.000Z"
          },
          "uptime": {
            "type": "number",
            "example": 42.5
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ],
            "example": "connected"
          }
        },
        "required": [
          "status",
          "timestamp",
          "uptime",
          "database"
        ]
      }
    }
  }
}