# ─────────────────────────────────────────────────────────────
# collab-board — environment template
# Copy to `.env.local` (frontend) or `.env` (backend) and fill in.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Frontend (apps/frontend) ────────────────────────────────
# Public base URL of the REST API. Must be prefixed with
# NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_URL=

# Public URL of the realtime (WebSocket) gateway.
NEXT_PUBLIC_WS_URL=

# ── Backend (apps/backend) ──────────────────────────────────
# Reserved: the backend app is not implemented yet.
# PORT=
# DATABASE_URL=
# REDIS_URL=
# JWT_SECRET=
