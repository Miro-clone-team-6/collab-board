# Server Environments
NODE_ENV=development
API_PORT=3001
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Docker & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collab_board
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab_board?schema=public


# JWT Authentication
JWT_ACCESS_SECRET=collab-board-dev-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=collab-board-dev-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OpenAI Integration (Miro AI Features)
OPENAI_API_KEY=sk-your-openai-api-key-here
